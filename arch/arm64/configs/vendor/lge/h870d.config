# LG Platform
CONFIG_MACH_MSM8996_LUCYE_GLOBAL_COM=y

# DirtySanta-style modem fixups for engineering bootloaders
CONFIG_DIRTYSANTA_FIXUP_G6=y
CONFIG_DIRTYSANTA_FIXUP_G6_DEVICENAME="LG-H870"
CONFIG_DIRTYSANTA_FIXUP_G6_NTCODE="23410,02"
CONFIG_DIRTYSANTA_FIXUP_G6_SIMCOUNT=1

# Remove incorrect modem parameters from the bootloader cmdline
CONFIG_CMDLINE_SEARCHREPLACE=y
CONFIG_CMDLINE_SAR_ENABLE0=y
CONFIG_CMDLINE_SAR_SEARCH0=" model.name=LGM-G600L "
CONFIG_CMDLINE_SAR_REPLACE0=" "
CONFIG_CMDLINE_SAR_ENABLE1=y
CONFIG_CMDLINE_SAR_SEARCH1=" androidboot.serialno=LGMG600L"
CONFIG_CMDLINE_SAR_REPLACE1=" androidboot.serialno=LGH870"

# Broadcom - Wifi
CONFIG_BCMDHD=y
CONFIG_BCMDHD_LEGACY=y
CONFIG_BCMDHD_PCIE=y
CONFIG_BCM43455=y
CONFIG_BCMDHD_COB=y
CONFIG_BCMDHD_USE_SCHED_SCAN=y
# CONFIG_BCMDHD_FOLLOW_AP_DTIM_PERIOD is not set
CONFIG_WIFI_CONTROL_FUNC=y
